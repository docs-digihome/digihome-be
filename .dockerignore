##
## Specific to .dockerignore
##

.git/
Dockerfile
contrib/

##
## Common with .gitignore
##

# Temporary files
*~
*#
.#*

# Vendors
node_modules/
vendor/

# Binaries for programs and plugins
dist/
gin-bin
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# ENV. comment this out if you wanna use .env file
.env*

tmp

# config file (yaml configs only, not the config package)
config*.yaml
config*.yml
config.yaml.example
